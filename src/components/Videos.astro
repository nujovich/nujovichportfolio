---
const videos = [
  { id: 'ffQYHnPhRV8', title: 'Charla reciente',                         tag: 'Última charla', featured: true },
  { id: 'igHnQ52lGrg', title: 'Astro — el framework web moderno',        tag: 'Astro' },
  { id: 'bMdlBjKSQF4', title: 'Entrevista Commit Conf 2024',             tag: 'Commit Conf' },
  { id: 'BD930rVGQc0', title: 'Seguridad Web — OWASP Top 10',            tag: 'Seguridad' },
  { id: 'UcfMiU1Nk6E', title: 'Bienvenidos a Mermelada Tech',            tag: 'Comunidad' },
  { id: 'eBJNT8KV0ps', title: 'Mermelada Tech en DevDay4Women',          tag: 'Evento' },
  { id: 'hQdEi54-pvw', title: 'Meetup 2024: Chicas en comunidades tech', tag: 'Meetup' },
];

const styles = [
  { color: "pink",     rot:  3, tx:  -8, ty:  10 },
  { color: "yellow",   rot: -4, tx:  10, ty:  30 },
  { color: "mint",     rot:  2, tx:  -4, ty:  -6 },
  { color: "peach",    rot: -3, tx:  12, ty:  22 },
  { color: "blue",     rot:  4, tx:   0, ty:  -18 },
  { color: "lavender", rot: -5, tx:  -10, ty: 14 },
  { color: "yellow",   rot:  3, tx:   6, ty:  -8 },
];
---

<section
  id="videos"
  class="relative py-24 md:py-32 px-6 bg-slate-900/60 overflow-hidden"
>
  <div class="corkboard" aria-hidden="true"></div>

  <div class="relative max-w-6xl mx-auto">
    <div class="text-center mb-20" data-reveal>
      <p class="text-brand-400 text-sm font-semibold tracking-widest uppercase mb-3">YouTube</p>
      <h2 class="text-4xl md:text-5xl font-extrabold text-white" data-reveal style="--reveal-delay: 80ms">
        Charlas & <span class="gradient-text">Videos</span>
      </h2>
    </div>

    <div class="postit-grid">
      {
        videos.map(({ id, title, tag, featured }, i) => {
          const s = styles[i % styles.length];
          return (
            <button
              class={`postit postit--${s.color} postit--video yt-facade`}
              data-id={id}
              data-title={title}
              data-cursor-label="Play"
              data-reveal
              style={`--rot: ${s.rot}deg; --tx: ${s.tx}px; --ty: ${s.ty}px; --reveal-delay: ${i * 80}ms;`}
              aria-label={`Reproducir: ${title}`}
            >
              <span class="postit__tape" aria-hidden="true"></span>
              <div class="postit__thumb">
                <img
                  src={`https://img.youtube.com/vi/${id}/hqdefault.jpg`}
                  alt=""
                  width="480" height="360"
                  loading="lazy" decoding="async"
                />
                <span class="postit__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </div>
              <div class="postit__meta">
                {tag && <span class="postit__tag postit__tag--dark">#{tag}</span>}
                {featured && <span class="postit__badge postit__badge--featured">★ Destacado</span>}
              </div>
              <h3 class="postit__title postit__title--sm">{title}</h3>
            </button>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.yt-facade').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id    = btn.dataset.id;
      const title = btn.dataset.title ?? '';
      const iframe = document.createElement('iframe');
      iframe.src   = `https://www.youtube.com/embed/${id}?autoplay=1`;
      iframe.title = title;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.className = 'w-full h-full absolute inset-0';
      iframe.style.border = '0';
      // Replace the whole postit with an iframe centered in the section
      const wrapper = document.createElement('div');
      wrapper.className = 'postit postit--video is-playing';
      wrapper.style.transform = 'none';
      wrapper.style.position  = 'relative';
      wrapper.style.aspectRatio = '16/9';
      wrapper.appendChild(iframe);
      btn.replaceWith(wrapper);
    });
  });
</script>
