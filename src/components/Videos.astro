---
const videos = [
  { id: 'ffQYHnPhRV8', title: 'Charla reciente',                         tag: 'Última charla', featured: true },
  { id: 'igHnQ52lGrg', title: 'Astro — el framework web moderno',        tag: 'Astro' },
  { id: 'bMdlBjKSQF4', title: 'Entrevista Commit Conf 2024',             tag: 'Commit Conf 2024' },
  { id: 'BD930rVGQc0', title: 'Seguridad Web — OWASP Top 10',            tag: 'Seguridad' },
  { id: 'UcfMiU1Nk6E', title: 'Bienvenidos a Mermelada Tech',            tag: 'Comunidad' },
  { id: 'eBJNT8KV0ps', title: 'Mermelada Tech en DevDay4Women',          tag: 'Evento' },
  { id: 'hQdEi54-pvw', title: 'Meetup 2024: Chicas en comunidades tech', tag: 'Meetup 2024' },
];
---

<section id="videos" class="tinta-section tinta-videos">
  <div class="tinta-section__header">
    <span class="tinta-section-num">04</span>
    <h2 class="tinta-h2" data-reveal>Charlas & Videos</h2>
  </div>

  <p class="tinta-lede" data-reveal style="--reveal-delay: 80ms">
    Mis apariciones en conferencias, comunidades y canales.
  </p>

  <div class="tinta-contact-sheet">
    {
      videos.map(({ id, title, tag, featured }, i) => (
        <figure
          class={`tinta-reel ${featured ? 'tinta-reel--featured' : ''}`}
          data-reveal
          style={`--reveal-delay: ${i * 70}ms;`}
        >
          <button
            type="button"
            class="tinta-reel__frame yt-facade"
            data-id={id}
            data-title={title}
            data-cursor-label="Play"
            aria-label={`Reproducir: ${title}`}
          >
            <img
              src={`https://img.youtube.com/vi/${id}/hqdefault.jpg`}
              alt=""
              width="480" height="360"
              loading="lazy" decoding="async"
            />
            <span class="tinta-reel__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </span>
          </button>
          <figcaption class="tinta-reel__caption">
            <span class="tinta-mono">{String(i + 1).padStart(2, '0')} — {tag}</span>
            <span class="tinta-reel__title">{title}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.yt-facade').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id    = btn.dataset.id;
      const title = btn.dataset.title ?? '';
      const iframe = document.createElement('iframe');
      iframe.src   = `https://www.youtube.com/embed/${id}?autoplay=1`;
      iframe.title = title;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      // Swap the thumbnail for the player, keeping the 16:9 frame and caption
      const wrapper = document.createElement('div');
      wrapper.className = 'tinta-reel__frame is-playing';
      wrapper.appendChild(iframe);
      btn.replaceWith(wrapper);
    });
  });
</script>
