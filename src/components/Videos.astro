---
const videos = [
  {
    id: 'ffQYHnPhRV8',
    title: 'Charla reciente',
    description: '',
    event: '',
    tag: '',
    featured: true,
  },
  {
    id: 'igHnQ52lGrg',
    title: 'Charla sobre Astro',
    description:
      'Mi última charla sobre Astro, el framework web moderno para construir sitios rápidos y orientados al contenido.',
    event: 'Charla Astro',
    tag: '🚀 Astro',
  },
  {
    id: 'bMdlBjKSQF4',
    title: 'Entrevista en Commit Conf 2024',
    description:
      'Entrevista en la Commit Conf 2024, una de las conferencias de desarrollo de software más importantes de España, celebrada en Madrid.',
    event: 'Commit Conf 2024',
    tag: '🎤 Conferencia',
  },
  {
    id: 'BD930rVGQc0',
    title: 'Seguridad Web',
    description:
      'Charla sobre los principales riesgos de seguridad web según OWASP Top 10, con ejemplos prácticos y cómo proteger tus aplicaciones.',
    event: 'AccelOne Tech Talk',
    tag: '🔒 Seguridad',
  },
  {
    id: 'UcfMiU1Nk6E',
    title: 'Bienvenidos a Mermelada Tech',
    description:
      'Video de presentación de la comunidad Mermelada Tech, el espacio inclusivo para mujeres y personas diversas en tecnología.',
    event: 'Mermelada Tech',
    tag: '🍓 Comunidad',
  },
  {
    id: 'eBJNT8KV0ps',
    title: 'Mermelada Tech en DevDay4Women',
    description:
      'Presentación de la comunidad Mermelada Tech en el Dev Day 4 Women, evento dedicado a visibilizar mujeres en tecnología.',
    event: 'DevDay4Women',
    tag: '🌸 Evento',
  },
  {
    id: 'hQdEi54-pvw',
    title: 'Meetup 2024: Chicas en comunidades tech',
    description:
      'Meetup de Mermelada Tech en 2024, con debate y reflexiones sobre la participación de mujeres en comunidades tecnológicas.',
    event: 'Mermelada Tech Meetup',
    tag: '🤝 Meetup',
  },
];
---

<section
  id="videos"
  class="relative bg-slate-900/50"
  data-circular-scroll
  data-arc-span="80"
  data-arc-radius="1550"
  data-arc-overshoot="30"
>
  <div
    data-circular-pin
    class="sticky top-0 h-screen overflow-hidden flex flex-col"
  >
    <div class="relative z-10 text-center pt-16 md:pt-20 px-6">
      <p class="text-brand-400 text-sm font-semibold tracking-widest uppercase mb-3" data-reveal>
        YouTube
      </p>
      <h2 class="text-4xl md:text-5xl font-extrabold text-white" data-reveal style="--reveal-delay: 80ms">
        Charlas & <span class="gradient-text">Videos</span>
      </h2>
      <p class="text-slate-500 mt-3 text-sm hidden md:block" data-reveal style="--reveal-delay: 160ms">
        Mis apariciones — hacé scroll para navegar el carrusel ↻
      </p>
    </div>

    <div data-circular-wheel>
      {
        videos.map(({ id, title, description, tag, featured }) => (
          <div
            data-circular-card
            class={`glass rounded-2xl overflow-hidden card-hover spotlight group ${featured ? "is-featured" : ""}`}
          >
            <div class="aspect-video w-full">
              <button
                class="yt-facade relative w-full h-full block group"
                data-id={id}
                data-title={title}
                data-cursor-label="Play"
                aria-label={`Reproducir: ${title}`}
              >
                <img
                  src={`https://img.youtube.com/vi/${id}/hqdefault.jpg`}
                  alt=""
                  width="480"
                  height="360"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                />
                <div class="absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/50 transition-colors">
                  <div class="w-14 h-14 bg-red-600 rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                    <svg class="w-5 h-5 text-white ml-1" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </div>
                </div>
              </button>
            </div>
            <div class="p-4">
              {tag && <span class="text-[10px] text-slate-500 block mb-1">{tag}</span>}
              <h3 class="text-sm md:text-base font-bold text-white mb-1 line-clamp-2">{title}</h3>
              {description && (
                <p class="text-slate-400 text-xs leading-relaxed line-clamp-2">{description}</p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.yt-facade').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.id;
      const title = btn.dataset.title ?? '';
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
      iframe.title = title;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.className = 'w-full h-full';
      iframe.style.border = '0';
      btn.replaceWith(iframe);
    });
  });
</script>
