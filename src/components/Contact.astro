---
const socials = [
  { name: 'LinkedIn',       href: 'https://linkedin.com/in/nadiaujovich' },
  { name: 'GitHub',         href: 'https://github.com/nujovich' },
  { name: 'Twitter / X',    href: 'https://twitter.com/nujovich' },
  { name: 'YouTube',        href: 'https://www.youtube.com/@mermeladatech' },
  { name: 'WhatsApp',       href: 'https://wa.me/34637003526' },
  { name: 'Mermelada Tech', href: 'https://linktr.ee/mermeladatech' },
];
---

<section id="contact" class="tinta-section tinta-contact">
  <div class="tinta-section__header">
    <span class="tinta-section-num">05</span>
    <h2 class="tinta-h2" data-reveal>Hablemos</h2>
  </div>

  <p class="tinta-contact__lede tinta-serif" data-reveal style="--reveal-delay: 80ms">
    Un proyecto, una charla, o solo conectar. Escribime y te respondo
    lo antes posible.
  </p>

  <a
    href="mailto:contacto@nadiaujovich.dev"
    class="tinta-contact__mail"
    data-magnetic
    data-magnetic-strength="0.15"
    data-cursor-label="Escribir"
    data-reveal
    style="--reveal-delay: 160ms"
  >
    <span class="tinta-contact__mail-address tinta-serif">contacto@nadiaujovich.dev</span>
    <span class="tinta-contact__mail-arrow" aria-hidden="true">→</span>
  </a>

  <div class="tinta-contact__socials">
    {socials.map(({ name, href }, i) => (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="tinta-contact__social"
        data-cursor-label="Abrir"
        data-reveal
        style={`--reveal-delay: ${200 + i * 60}ms`}
      >
        <span class="tinta-mono">{String(i + 1).padStart(2, '0')}</span>
        <span class="tinta-contact__social-name">{name}</span>
        <span class="tinta-contact__social-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</section>
