---
---

<section
  id="hero"
  class="tinta-hero"
  data-tinta-mode="ink"
>
  <!-- WebGL shader in the background — recoloured to warm cream & ink tones -->
  <canvas
    id="hero-canvas"
    class="hero-canvas"
    aria-hidden="true"
    data-parallax="-0.12"
  ></canvas>

  <div class="tinta-hero__inner">
    <div class="tinta-hero__eyebrow tinta-mono tinta-eyebrow--dark" data-reveal>
      Identidad personal · Dirección «Tinta» · 2026
    </div>

    <div class="tinta-hero__name-row">
      <h1 class="tinta-hero__name" data-reveal style="--reveal-delay: 120ms">
        Nadia<br/>Ujovich
      </h1>
      <div class="tinta-hero__descriptor" data-reveal style="--reveal-delay: 240ms">
        <div class="tinta-hero__filet"></div>
        <div class="tinta-hero__role">
          Software<br/>Developer
        </div>
      </div>
    </div>

    <p class="tinta-hero__lede tinta-serif" data-reveal style="--reveal-delay: 360ms">
      Escribo software, doy charlas y co-fundé una comunidad tech.
      Tipografía, blanco y una sola tinta.
    </p>

    <div class="tinta-hero__ctas" data-reveal style="--reveal-delay: 480ms">
      <a
        href="#projects"
        class="tinta-btn tinta-btn--ink"
        data-magnetic
        data-magnetic-strength="0.2"
        data-cursor-label="Ver"
      >
        <span>Ver proyectos</span>
        <span class="tinta-btn__arrow" aria-hidden="true">→</span>
      </a>
      <a
        href="#contact"
        class="tinta-btn tinta-btn--ghost"
        data-magnetic
        data-magnetic-strength="0.2"
        data-cursor-label="Escribir"
      >
        <span>Escribime</span>
      </a>
    </div>
  </div>

  <div class="tinta-hero__scroll-cue tinta-mono tinta-eyebrow--dark">
    <span>Scroll</span>
    <span class="tinta-hero__scroll-line" aria-hidden="true"></span>
  </div>
</section>
