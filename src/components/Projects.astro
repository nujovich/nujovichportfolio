---
import { Image } from "astro:assets";
import mermeladaLogo from "../assets/mermelada.png";

const projects = [
  {
    title: "Mermelada Tech",
    description:
      "Comunidad tech inclusiva para mujeres y personas no binarias en tecnología. Meetups, workshops y charlas.",
    tags: ["Comunidad", "Tech", "Inclusión"],
    logo: mermeladaLogo,
    url: "https://linktr.ee/mermeladatech",
    featured: true,
  },
  {
    title: "Awake",
    description:
      "Diseño y desarrollo de la web de Awake, agencia de marketing digital en Alicante.",
    tags: ["Web", "Marketing", "Alicante"],
    logoUrl: "/awake-logo.svg",
    url: "https://www.awakemarketing.es/",
    featured: true,
  },
  {
    title: "Mint",
    description:
      "Herramienta open source para auditar CSS. Playground web + CLI, en construcción activa.",
    tags: ["CSS", "DevTool", "Open Source"],
    icon: "🌱",
    url: "https://github.com/nujovich/mint",
    featured: false,
    inProgress: true,
  },
  {
    title: "WTM GDG Madrid",
    description:
      "Desarrollo y mantenimiento de la web oficial de Women Techmakers GDG Madrid como Ambassador desde 2023.",
    tags: ["WTM", "GDG", "Open Source"],
    logoUrl: "/wtm-madrid-logo.png",
    url: "https://wtmgdgmadrid.github.io/",
    featured: false,
  },
  {
    title: "Seguridad Web",
    description:
      "Charlas y talleres sobre OWASP Top 10 y buenas prácticas de seguridad en aplicaciones modernas.",
    tags: ["Seguridad", "OWASP"],
    icon: "🔐",
    url: "#videos",
    featured: false,
  },
  {
    title: "Commit Conf 2024",
    description:
      "Speaker en una de las conferencias de desarrollo de software más importantes de España.",
    tags: ["Speaker", "Conferencia"],
    icon: "🎤",
    url: "#videos",
    featured: false,
  },
];

// Per-project post-it visual randomness (deterministic per index)
const styles = [
  { color: "yellow",   rot: -4, tx:  -6, ty:   0 },
  { color: "pink",     rot:  3, tx:  10, ty:  24 },
  { color: "blue",     rot: -2, tx:  -8, ty: -14 },
  { color: "mint",     rot:  5, tx:  14, ty:  30 },
  { color: "peach",    rot: -3, tx:  -4, ty:   6 },
  { color: "lavender", rot:  4, tx:   8, ty: -18 },
];
---

<section
  id="projects"
  class="relative py-24 md:py-32 px-6 bg-slate-950 overflow-hidden"
>
  <!-- Corkboard background -->
  <div class="corkboard" aria-hidden="true"></div>

  <div class="relative max-w-6xl mx-auto">
    <div class="text-center mb-20" data-reveal>
      <p class="text-brand-400 text-sm font-semibold tracking-widest uppercase mb-3">
        Proyectos & Charlas
      </p>
      <h2 class="text-4xl md:text-5xl font-extrabold text-white" data-reveal style="--reveal-delay: 80ms">
        Lo que he <span class="gradient-text">construido</span>
      </h2>
    </div>

    <div class="postit-grid">
      {
        projects.map(
          ({ title, description, tags, icon, logo, logoUrl, url, featured, inProgress }, i) => {
            const s = styles[i % styles.length];
            return (
              <a
                href={url}
                target={url.startsWith("http") ? "_blank" : undefined}
                rel={url.startsWith("http") ? "noopener noreferrer" : undefined}
                class={`postit postit--${s.color}`}
                data-cursor-label={url.startsWith("http") ? "Ver" : "Ir"}
                data-reveal
                style={`--rot: ${s.rot}deg; --tx: ${s.tx}px; --ty: ${s.ty}px; --reveal-delay: ${i * 90}ms;`}
              >
                <span class="postit__tape" aria-hidden="true"></span>
                <div class="postit__head">
                  {logo ? (
                    <Image src={logo} alt={title} height={56} width={56} class="postit__logo" loading="lazy" />
                  ) : logoUrl ? (
                    <img src={logoUrl} alt={title} class="postit__logo" loading="lazy" />
                  ) : (
                    <span class="postit__icon" aria-hidden="true">{icon}</span>
                  )}
                  <div class="postit__badges">
                    {featured   && <span class="postit__badge postit__badge--featured">★ Destacado</span>}
                    {inProgress && <span class="postit__badge postit__badge--progress">● En curso</span>}
                  </div>
                </div>
                <h3 class="postit__title">{title}</h3>
                <p class="postit__desc">{description}</p>
                <div class="postit__tags">
                  {tags.map((tag) => <span class="postit__tag">#{tag}</span>)}
                </div>
              </a>
            );
          },
        )
      }
    </div>
  </div>
</section>
