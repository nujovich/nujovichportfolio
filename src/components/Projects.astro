---
import { Image } from "astro:assets";
import mermeladaLogo from "../assets/mermelada.png";

// Destacados: se muestran como "portadas" editoriales con ficha técnica.
const features = [
  {
    eyebrow: "Destacado 01 · Comunidad",
    title: "Mermelada Tech",
    description:
      "Comunidad tech inclusiva para mujeres y personas no binarias en tecnología. Meetups, workshops y charlas.",
    logo: mermeladaLogo,
    facts: [
      { label: "Tipo", value: "Comunidad" },
      { label: "Formatos", value: "Meetups · Workshops · Charlas" },
      { label: "Foco", value: "Inclusión en tech" },
    ],
    url: "https://linktr.ee/mermeladatech",
    cta: "Linktree",
  },
  {
    eyebrow: "Destacado 02 · Cliente",
    title: "Awake",
    description:
      "Diseño y desarrollo de la web de Awake, agencia de marketing digital en Alicante.",
    logoUrl: "/awake-logo.svg",
    facts: [
      { label: "Rol", value: "Diseño + desarrollo" },
      { label: "Tipo", value: "Web corporativa" },
      { label: "Lugar", value: "Alicante" },
    ],
    url: "https://www.awakemarketing.es/",
    cta: "Ver sitio",
  },
];

// Resto: índice compacto.
const more = [
  {
    title: "Mint",
    description: "Herramienta open source para auditar CSS. Playground web + CLI, en construcción activa.",
    meta: "CSS · DevTool · Open Source",
    url: "https://github.com/nujovich/mint",
    inProgress: true,
  },
  {
    title: "WTM GDG Madrid",
    description: "Desarrollo y mantenimiento de la web oficial de Women Techmakers GDG Madrid como Ambassador.",
    meta: "WTM · GDG · 2023—",
    url: "https://wtmgdgmadrid.github.io/",
  },
];
---

<section id="projects" class="tinta-section tinta-projects">
  <div class="tinta-section__header">
    <span class="tinta-section-num">03</span>
    <h2 class="tinta-h2" data-reveal>Proyectos</h2>
  </div>

  <p class="tinta-lede" data-reveal style="--reveal-delay: 80ms">
    Cosas que construí, mantengo o impulso desde la comunidad.
  </p>

  <div class="tinta-features">
    {
      features.map(({ eyebrow, title, description, logo, logoUrl, facts, url, cta }, i) => (
        <article class={`tinta-feature ${i % 2 === 1 ? "tinta-feature--reverse" : ""}`} data-reveal>
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="tinta-feature__media"
            data-cursor-label="Ver"
            tabindex="-1"
            aria-hidden="true"
          >
            {logo ? (
              <Image src={logo} alt="" width={320} height={320} class="tinta-feature__logo" loading="lazy" />
            ) : (
              <img src={logoUrl} alt="" class="tinta-feature__logo tinta-feature__logo--wide" loading="lazy" />
            )}
          </a>
          <div class="tinta-feature__body">
            <span class="tinta-eyebrow">{eyebrow}</span>
            <h3 class="tinta-feature__title">{title}</h3>
            <p class="tinta-feature__desc">{description}</p>
            <dl class="tinta-facts">
              {facts.map(({ label, value }) => (
                <>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </>
              ))}
            </dl>
            <a href={url} target="_blank" rel="noopener noreferrer" class="tinta-feature__cta" data-cursor-label="Ver">
              {cta} <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <div class="tinta-more" data-reveal>
    <span class="tinta-eyebrow tinta-more__label">También</span>
    <div class="tinta-more__grid">
      {
        more.map(({ title, description, meta, url, inProgress }) => (
          <a href={url} target="_blank" rel="noopener noreferrer" class="tinta-more__item" data-cursor-label="Ver">
            <span class="tinta-more__head">
              <span class="tinta-more__title">{title}</span>
              {inProgress && <span class="tinta-pill">● En curso</span>}
            </span>
            <span class="tinta-more__desc">{description}</span>
            <span class="tinta-mono">{meta}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
