---
import { Image } from "astro:assets";
import mermeladaLogo from "../assets/mermelada.png";

const projects = [
  {
    title: "Mermelada Tech",
    description:
      "Comunidad tech inclusiva para mujeres y personas no binarias en tecnología. Organizo meetups, workshops y charlas para impulsar la diversidad en el sector.",
    tags: ["Comunidad", "Tech", "Inclusión"],
    logo: mermeladaLogo,
    url: "https://linktr.ee/mermeladatech",
    featured: true,
  },
  {
    title: "Awake",
    description:
      "Diseño y desarrollo de la web de Awake, una agencia de marketing digital en Alicante. Una presencia online moderna y cuidada para impulsar su crecimiento.",
    tags: ["Web", "Marketing", "Alicante"],
    logoUrl: "/awake-logo.svg",
    url: "https://www.awakemarketing.es/",
    featured: true,
  },
  {
    title: "Mint",
    description:
      "Herramienta de desarrollo open source para auditar CSS. Cuenta con playground web y CLI, actualmente en pre-release y en construcción activa.",
    tags: ["CSS", "DevTool", "Open Source"],
    icon: "🌱",
    url: "https://github.com/nujovich/mint",
    featured: false,
    inProgress: true,
  },
  {
    title: "WTM GDG Madrid",
    description:
      "Contribuyo al desarrollo y mantenimiento de la web oficial de Women Techmakers GDG Madrid como parte de mi rol como Ambassador desde 2023.",
    tags: ["WTM", "GDG", "Open Source"],
    logoUrl: "/wtm-madrid-logo.png",
    url: "https://wtmgdgmadrid.github.io/",
    featured: false,
  },
  {
    title: "Seguridad Web",
    description:
      "Charlas y talleres sobre OWASP Top 10, buenas prácticas de seguridad web y cómo proteger aplicaciones modernas ante las amenazas más comunes.",
    tags: ["Seguridad", "OWASP", "Web"],
    icon: "🔐",
    url: "#videos",
    featured: false,
  },
  {
    title: "Commit Conf 2024",
    description:
      "Participación como speaker en una de las conferencias de desarrollo de software más importantes de España, con ponencias sobre tecnología moderna.",
    tags: ["Speaker", "Conferencia", "España"],
    icon: "🎤",
    url: "#videos",
    featured: false,
  },
];
---

<section
  id="projects"
  class="relative bg-slate-950"
  data-horizontal-scroll
>
  <div
    data-horizontal-pin
    class="sticky top-0 h-screen overflow-hidden flex flex-col justify-center"
  >
    <!-- Header on top of the pinned viewport -->
    <div class="px-6 md:px-16 pt-24 md:pt-16 pb-8 max-w-6xl">
      <p
        class="text-brand-400 text-sm font-semibold tracking-widest uppercase mb-3"
        data-reveal
      >
        Proyectos & Charlas
      </p>
      <h2
        class="text-4xl md:text-6xl font-extrabold text-white leading-[1.05]"
        data-reveal
        style="--reveal-delay: 80ms"
      >
        Lo que he <span class="gradient-text">construido</span>
      </h2>
      <p
        class="text-slate-400 mt-4 max-w-xl hidden md:block"
        data-reveal
        style="--reveal-delay: 160ms"
      >
        Scrolleá para navegar el trabajo →
      </p>
    </div>

    <!-- Horizontal track -->
    <div
      data-horizontal-track
      class="flex gap-6 md:gap-8 px-6 md:px-16 pb-16"
      style="width: max-content"
    >
      {
        projects.map(
          (
            {
              title,
              description,
              tags,
              icon,
              logo,
              logoUrl,
              url,
              featured,
              inProgress,
            },
            idx,
          ) => (
            <a
              href={url}
              target={url.startsWith("http") ? "_blank" : undefined}
              rel={url.startsWith("http") ? "noopener noreferrer" : undefined}
              class={`glass rounded-2xl p-8 card-hover spotlight group block shrink-0 flex flex-col justify-between ${featured ? "bg-gradient-to-br from-brand-900/30 to-accent-600/10" : ""}`}
              style={`width: min(80vw, ${featured ? "560px" : "420px"}); height: 62vh; max-height: 520px;`}
            >
              <div>
                <div class="flex items-start justify-between mb-6">
                  {logo ? (
                    <Image
                      src={logo}
                      alt={title}
                      height={72}
                      width={72}
                      class="h-16 w-auto object-contain"
                      loading="lazy"
                    />
                  ) : logoUrl ? (
                    <img
                      src={logoUrl}
                      alt={title}
                      class="h-16 w-auto object-contain"
                      loading="lazy"
                    />
                  ) : (
                    <span class="text-5xl" aria-hidden="true">
                      {icon}
                    </span>
                  )}
                  <div class="flex flex-col items-end gap-2">
                    <span class="text-xs font-mono text-slate-500">
                      {String(idx + 1).padStart(2, "0")} / {String(projects.length).padStart(2, "0")}
                    </span>
                    {featured && (
                      <span class="text-xs font-semibold text-brand-400 bg-brand-400/10 border border-brand-400/20 rounded-full px-3 py-1">
                        Destacado
                      </span>
                    )}
                    {inProgress && (
                      <span class="text-xs font-semibold text-emerald-400 bg-emerald-400/10 border border-emerald-400/20 rounded-full px-3 py-1 inline-flex items-center gap-1.5">
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse" />
                        En curso
                      </span>
                    )}
                  </div>
                </div>
                <h3 class="text-2xl md:text-3xl font-bold text-white mb-4 group-hover:text-brand-400 transition-colors">
                  {title}
                </h3>
                <p class="text-slate-400 leading-relaxed text-sm md:text-base">
                  {description}
                </p>
              </div>
              <div class="flex flex-wrap gap-2 mt-6">
                {tags.map((tag) => (
                  <span class="text-xs font-medium px-3 py-1 bg-white/5 border border-white/10 rounded-full text-slate-300">
                    {tag}
                  </span>
                ))}
              </div>
            </a>
          ),
        )
      }
      <!-- End spacer so last card can center nicely -->
      <div class="shrink-0" style="width: 12vw" aria-hidden="true"></div>
    </div>
  </div>
</section>
