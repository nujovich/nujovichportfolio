---
const categories = [
  { num: '01', label: 'Frontend',        skills: ['React', 'Astro', 'TypeScript', 'Tailwind CSS', 'Next.js', 'Vue.js'] },
  { num: '02', label: 'Backend',         skills: ['Node.js', 'Python', 'REST APIs', 'GraphQL', 'PostgreSQL', 'MongoDB'] },
  { num: '03', label: 'DevOps & Cloud',  skills: ['Docker', 'AWS', 'CI/CD', 'Git', 'Linux', 'Kubernetes'] },
  { num: '04', label: 'Seguridad',       skills: ['OWASP Top 10', 'Pentesting Web', 'Auth & OAuth', 'HTTPS/TLS', 'Seguridad API'] },
];
---

<section id="skills" class="tinta-section tinta-skills">
  <div class="tinta-section__header">
    <span class="tinta-section-num">02</span>
    <h2 class="tinta-h2" data-reveal>Stack tecnológico</h2>
  </div>

  <p class="tinta-lede" data-reveal style="--reveal-delay: 80ms">
    Cuatro áreas en las que trabajo día a día. Sin logos, sin decoraciones —
    solo los nombres que uso.
  </p>

  <div class="tinta-skills__grid">
    {categories.map((cat, i) => (
      <div class="tinta-skills__col" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
        <div class="tinta-skills__head">
          <span class="tinta-mono">{cat.num}</span>
          <span class="tinta-skills__label">{cat.label}</span>
        </div>
        <hr class="tinta-rule tinta-rule--ink" />
        <ul class="tinta-skills__list">
          {cat.skills.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>
