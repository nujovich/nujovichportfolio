---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Nadia Ujovich — Desarrolladora, Tech Speaker & WTM Ambassador',
  description = 'Portfolio de Nadia Ujovich, desarrolladora de software full-stack, tech speaker, Women Techmakers Ambassador en Madrid y co-fundadora de Mermelada Tech.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://nadiaujovich.dev');
const ogImage = 'https://nadiaujovich.dev/nadia.jpeg';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nadia Ujovich" />
    <meta name="keywords" content="Nadia Ujovich, desarrolladora software, tech speaker, Women Techmakers Ambassador, Mermelada Tech, Madrid, full-stack developer, Astro, React, seguridad web" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph (LinkedIn, Facebook, WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content="Nadia Ujovich — Desarrolladora & Tech Speaker" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Nadia Ujovich" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@nujovich" />
    <meta name="twitter:creator" content="@nujovich" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD structured data — Google usa esto para el Knowledge Panel -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Nadia Ujovich",
        "url": "https://nadiaujovich.dev",
        "image": "https://nadiaujovich.dev/nadia.jpeg",
        "email": "contacto@nadiaujovich.dev",
        "jobTitle": "Desarrolladora de Software & Tech Speaker",
        "description": "Desarrolladora full-stack, Women Techmakers Ambassador en Madrid y co-fundadora de Mermelada Tech.",
        "sameAs": [
          "https://linkedin.com/in/nadiaujovich",
          "https://github.com/nujovich",
          "https://twitter.com/nujovich",
          "https://linktr.ee/mermeladatech",
          "https://www.youtube.com/@mermeladatech"
        ],
        "knowsAbout": ["JavaScript", "TypeScript", "React", "Astro", "Seguridad Web", "Node.js"],
        "memberOf": {
          "@type": "Organization",
          "name": "Women Techmakers",
          "url": "https://wtmgdgmadrid.github.io/"
        },
        "founder": {
          "@type": "Organization",
          "name": "Mermelada Tech",
          "url": "https://linktr.ee/mermeladatech"
        }
      }
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=3" />
    <meta name="theme-color" content="#FBFAF8" />

    <!-- Fonts: async load to avoid render-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&family=Kalam:wght@400;700&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600&family=Kalam:wght@400;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <ClientRouter />
  </head>

  <body class="tinta-body antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[200] focus:px-4 focus:py-2 focus:bg-[#14130F] focus:text-[#FBFAF8]"
    >
      Saltar al contenido principal
    </a>

    <header
      id="navbar"
      class="fixed top-0 left-0 right-0 z-50 tinta-nav"
      transition:persist
    >
      <nav class="max-w-[1080px] mx-auto px-6 py-5 flex items-center justify-between">
        <a href="/" class="tinta-logo">
          <span class="tinta-logo__name">Nadia Ujovich</span>
        </a>
        <ul class="hidden md:flex items-center gap-7 tinta-nav__links">
          <li><a href="#about"   ><span class="tinta-nav__num">01</span>Sobre</a></li>
          <li><a href="#skills"  ><span class="tinta-nav__num">02</span>Stack</a></li>
          <li><a href="#projects"><span class="tinta-nav__num">03</span>Proyectos</a></li>
          <li><a href="#videos"  ><span class="tinta-nav__num">04</span>Charlas</a></li>
          <li><a href="#contact" ><span class="tinta-nav__num">05</span>Contacto</a></li>
        </ul>
        <button
          id="menu-toggle"
          class="md:hidden tinta-menu-btn"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </nav>
      <div id="mobile-menu" class="hidden md:hidden tinta-mobile-menu">
        <ul class="flex flex-col gap-4 px-6 py-5">
          <li><a href="#about"    class="block py-1">Sobre</a></li>
          <li><a href="#skills"   class="block py-1">Stack</a></li>
          <li><a href="#projects" class="block py-1">Proyectos</a></li>
          <li><a href="#videos"   class="block py-1">Charlas</a></li>
          <li><a href="#contact"  class="block py-1">Contacto</a></li>
        </ul>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="tinta-footer">
      <div class="max-w-[1080px] mx-auto px-6 py-10 flex flex-wrap items-baseline justify-between gap-4">
        <span class="tinta-mono tinta-mono--muted">© {new Date().getFullYear()} · Nadia Ujovich · Madrid</span>
        <span class="tinta-mono tinta-mono--muted">nadiaujovich.dev</span>
      </div>
    </footer>

    <script>
      import '../scripts/main';
    </script>
    <script>
      const navbar = document.getElementById('navbar');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 60) {
          navbar?.classList.add('is-scrolled');
        } else {
          navbar?.classList.remove('is-scrolled');
        }
      });

      const toggle = document.getElementById('menu-toggle');
      const menu   = document.getElementById('mobile-menu');
      toggle?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
        const isOpen = !menu?.classList.contains('hidden');
        toggle.setAttribute('aria-expanded', String(isOpen));
        toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      });
      menu?.querySelectorAll('a').forEach(a =>
        a.addEventListener('click', () => {
          menu.classList.add('hidden');
          toggle?.setAttribute('aria-expanded', 'false');
          toggle?.setAttribute('aria-label', 'Abrir menú de navegación');
        })
      );
    </script>
  </body>
</html>
